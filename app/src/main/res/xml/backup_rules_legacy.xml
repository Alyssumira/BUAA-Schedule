<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 11 及以下自动备份规则（android:fullBackupContent）。

  排除的文件名必须与代码里实际的 SharedPreferences 名一致：
  - buaa_cookie_store.xml  ← BuaaCookieStore.PREFS
  - spoc_token_store.xml   ← 老版本残留：T85 起本仓不再写这个文件（SpocTokenStore 已删），
    但装过旧版的设备上它还在，排除这一行**不许跟着删**（详见 backup_rules.xml 里同一条的理由）。
  - iclass_id_store.xml    ← IClassIdStore 的 prefsName = "iclass_id_store"：T84 新增的北航
    iClass 签到 id 的密文，与 buaa_cookie_store 同一套 KeystoreBlobStore、同一条排除理由。
    补上这一行的是 T85b-A，它由 BackupRulesCoverCredentialStoresTest 把尺 ——
    新增凭证存储却忘了在这里登记的话，那枚测试直接红。
  - buaa_session.xml       ← BuaaWebSession.PREFS_NAME

  此前这里写的是 secure_session.xml —— 项目里根本不存在这个 prefs，
  等于一条都没排除，登录会话材料一直在被自动备份上传。

  app_webview 是 WebView 的数据目录（Cookies / Local Storage / IndexedDB），
  里面才是跨设备真正可用的 SSO 凭证，必须一起排除（R5 F-C3）。
-->
<full-backup-content>
    <exclude domain="sharedpref" path="buaa_cookie_store.xml" />
    <exclude domain="sharedpref" path="spoc_token_store.xml" />
    <exclude domain="sharedpref" path="iclass_id_store.xml" />
    <exclude domain="sharedpref" path="buaa_session.xml" />
    <exclude domain="root" path="app_webview" />
</full-backup-content>
