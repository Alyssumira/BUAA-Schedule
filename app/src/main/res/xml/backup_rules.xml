<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ 云备份 / 设备迁移规则。

  排除对象是**鉴权材料**，不是课表数据（课表应当随备份迁移）：
  - buaa_cookie_store.xml：教务会话 Cookie 的 AndroidKeyStore 密文。
  - spoc_token_store.xml：⚠️ **老版本残留**——智学北航 JWT 的密文。T85 起本仓不再写入这个
    文件，但已经装过的设备上它还在（没有代码会去清它），所以这一条排除**不许跟着删**：
    少一行就是 quietly 把别人设备上的凭证密文送上云。密钥在设备安全硬件里，
    密文迁到新设备也解不开，属纯冗余；
  - iclass_id_store.xml：T84 新增的北航 iClass（轻新课堂）签到 `id` 的密文，
    与上面 `buaa_cookie_store.xml` 同一套 KeystoreBlobStore 实现、同一条排除理由。
    已在本卡（T85b-A）补进下面的两个块里。
    ⚠️ 这条名单由 `app/src/test/java/com/buaa/schedule/data/local/BackupRulesCoverCredentialStoresTest`
    当场把尺：它从源码里数出所有走 KeystoreBlobStore 的 prefs 名，逐个要求出现在两份规则文件里，
    新增凭证存储却忘了登记的人会在 `testDebugUnitTest` 上直接看到红灯。
  - buaa_session.xml：会话保留标志（PREF_RETAINED）。若不排除，
    新设备冷启动会带着"应当恢复会话"的标记去加载 byxt，白跑一次恢复流程。
  - 整个 database 域不排除：课表 Room 库必须能备份，否则换机丢课表。
  - app_webview：WebView 的数据目录，里面的 Cookies / Local Storage / IndexedDB
    才是**跨设备真正可用**的 SSO 凭证（R5 F-C3）。此前只排了两个 SharedPreferences
    文件，等于把登录态整份迁到新设备。
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="buaa_cookie_store.xml" />
        <exclude domain="sharedpref" path="spoc_token_store.xml" />
        <exclude domain="sharedpref" path="iclass_id_store.xml" />
        <exclude domain="sharedpref" path="buaa_session.xml" />
        <exclude domain="root" path="app_webview" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="buaa_cookie_store.xml" />
        <exclude domain="sharedpref" path="spoc_token_store.xml" />
        <exclude domain="sharedpref" path="iclass_id_store.xml" />
        <exclude domain="sharedpref" path="buaa_session.xml" />
        <exclude domain="root" path="app_webview" />
    </device-transfer>
</data-extraction-rules>
