<?xml version="1.0" encoding="utf-8"?>
<!--
  组件预览背景：已经是最终观感的深色，不参与运行时着色。

  线上布局（widget_bg_r*）用的是**纯白** shape，由 ImageView.setColorFilter 在
  onUpdate 里染色；而 initialLayout / previewLayout 是静态渲染的，没有人会给它染色，
  于是白底 + 白字在组件选择器里什么都看不见（R5 F-27）。
  颜色取 WidgetAppearance 默认值：#16203A × 80% 不透明度 = #CC16203A，圆角同默认档位。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="20dp" />
    <solid android:color="#CC16203A" />
</shape>
