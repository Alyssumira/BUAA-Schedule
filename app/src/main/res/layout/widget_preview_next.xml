<?xml version="1.0" encoding="utf-8"?>
<!--
  「下一节课」组件的预览 / 首帧布局（R5 F-27）。

  与 widget_next.xml 同构，但有两点必须不同：
  - 背景用**已经着色好**的 widget_preview_bg，而不是待 setColorFilter 染色的纯白 shape
    —— initialLayout 与组件选择器的预览都是静态渲染，运行时着色不会发生；
  - 内容是示例课表，空态下预览只会是一块深色板子，看不出组件长什么样。
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@android:id/background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:importantForAccessibility="no"
        android:contentDescription="@null"
        android:src="@drawable/widget_preview_bg" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_next_placeholder"
            android:textColor="#C9D6EE"
            android:textSize="12sp"
            android:letterSpacing="0.08" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/widget_preview_course_a"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/widget_preview_meta_a"
            android:textColor="#C9D6EE"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end" />

    </LinearLayout>

</FrameLayout>
