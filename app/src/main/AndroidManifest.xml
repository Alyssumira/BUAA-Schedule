<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!--
      实况通知（promoted ongoing / 澎湃超级岛 / ColorOS 流体云）在 Android 17 起要求本条权限：
      官方《创建实时更新通知》写明需在清单中声明，且 `android.Manifest.permission` 里
      这个常量**只存在于 android-37**（javap 对比 36/37 核实），所以 compileSdk 36 只能引字面量。
      R5 F-C10 曾以"canPostPromotedNotifications() 是只读查询不需要权限"为由删掉它——
      那句只对了一半：查询不需要，**发**需要。删掉后真机（澎湃 OS 4 / Android 17）的表现为
      "通知正常显示、一个也不上岛"，且系统不给任何回调。别再以商店审核为由删除。
    -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <!-- 课程实况前台服务（澎湃实况窗 / 流体云）：specialUse FGS 需要这两项权限 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />
    <!--
      用于「设置 → 提醒可靠性」引导用户关闭电池优化（ReminderGuidance 发出的
      Settings.ACTION_REQUEST_IGNORE_BATTERY_OPTIMIZATIONS 需要该权限）。
      注意：应用商店对这条权限有额外审核要求，若将来改为商店分发，
      需要改成纯说明页 + 手动跳转「电池优化」列表的引导方式，并移除本声明。
    -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!--
      短时 PARTIAL_WAKE_LOCK（5 秒，带超时自动释放）：包住上课闹钟广播里的
      DB 查询与全量重排。goAsync 只保证进程存活，Doze 下 CPU 可能中途入睡
      导致重排被打断、提醒链条断掉（SleepDown 同款做法）。
    -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <uses-permission android:name="android.permission.WRITE_CALENDAR" />
    <!--
      应用内更新：下载 APK 后要调起系统安装器。这条权限**不会**自动获得，
      只能由 UpdateCheck 把用户引导到「安装未知应用」开关手动放行；
      未放行时不拦路 —— 直接退回浏览器打开发布页下载。
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!--
      桌面快捷方式 / 小组件固定权限：由 Launcher 声明并在本应用安装时授予。
      不声明时部分 Launcher（国产 ROM 为主）会让 requestPinAppWidget 静默返回 false，
      用户点「一键添加」毫无反应；声明后应用内还能查到授权状态并引导放行。
    -->
    <uses-permission android:name="com.android.launcher.permission.INSTALL_SHORTCUT" />
    <!--
      SPOC 扫码签到：相机只在扫码页用到，授权由该页现取现用，不进开屏引导。
      uses-feature 必须 required=false —— 声明 true 会让无相机设备在商店里直接
      看不到本应用，而课表功能本身与相机无关。非 arm64 设备同理：
      packaging.jniLibs 只保留 arm64 的 libbarhopper_v3.so，那档设备上
      native 模型加载不了，扫码页靠「相册选图识别 / 手输签到码」继续可用。
    -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <!--
      allowBackup 保持开启（课表数据跨设备迁移是刚需），
      但**必须**靠 backup_rules / backup_rules_legacy 把鉴权材料排除干净：
      这里持有的是教务会话 Cookie（经 AndroidKeyStore 加密后的密文）。
      密文即使离开设备也解不开，但把会话材料复制到另一台设备没有任何正当用途，
      而 legacy 规则此前排除的是一个不存在的文件名（secure_session.xml），
      实际等于什么都没排除。
    -->
    <application
        android:name=".BUAAApplication"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules_legacy"
        android:dataExtractionRules="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.BUAASchedule">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.BUAASchedule">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 列表型组件的数据源：必须由系统以 BIND_REMOTEVIEWS 权限绑定 -->
        <service
            android:name=".widget.CourseListWidgetService"
            android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS" />

        <!-- 4x2 周网格组件的数据源 -->
        <service
            android:name=".widget.WeekGridWidgetService"
            android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS" />

        <!--
          桌面组件外观配置页：由 Launcher 在「拖放组件」或「长按组件 → 编辑」时拉起，
          intent 携带 EXTRA_APPWIDGET_ID。必须 exported 才能被 Launcher 启动。
        -->
        <activity
            android:name=".widget.WidgetConfigActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:label="@string/widget_config_title"
            android:theme="@style/Theme.BUAASchedule">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!--
          下载好的 APK 存在 cacheDir/update/，安装器是另一个进程，
          file:// URI 在 Android 7+ 会直接抛 FileUriExposedException，
          必须走 FileProvider 换 content:// 并临时授予读权限。
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!--
          WorkManager 改为按需初始化（T18：冷启动主线程账）。

          androidx.startup 的 InitializationProvider 是**起手**装的 ContentProvider，
          它跑在 Application.attachBaseContext 之后、onCreate 之前，全程在主线程上。
          它的 meta-data 里登记了四个 Initializer，其中
          `androidx.work.WorkManagerInitializer` 那一条会在主线程上就地
          `WorkManager.initialize(context, Configuration.Builder().build())`。
          反编译 work-runtime 2.9.1 看清了这一次到底在主线程上做了什么（量级待设备上量）：
          - `WorkManagerImplExtKt.createWorkManager` → `WorkDatabase.create(...)`：
            Room 那颗 WORKDATABASE 的构造（生成的 `WorkDatabase_Impl` 类加载 + OpenHelper 配置），
            真正的 SQLite 打开要等第一次 DAO 访问；
          - `Schedulers.createBestAvailableBackgroundScheduler` → `SystemJobScheduler`：
            连上 JobScheduler；
          - `Trackers` / `Processor` / `GreedyScheduler` / `WorkManagerTaskExecutor` 全套对象。
          注意 `ForceStopRunnable`（清理过期 work、pruneWork，是真磁盘活）只在这里被**构造**，
          跑是 `executeOnTaskThread` 派的 —— 它本来就不在主线程上，这张卡别把它记错了。
          这里只摘那一条 meta-data，让上面那一坨改由第一次真正使用 WorkManager 的调用点付。

          ⚠️ **只摘 meta-data，绝不摘 provider**（tools:node="merge" 而不是 "remove"）：
          provider 本身还挂着另外三条——
          - androidx.profileinstaller.ProfileInstallerInitializer：本应用自己分发、
            拿不到 Play 的云端 profile，Baseline Profile 只能靠它把包内那份写进
            /data/misc/release-profile（minSdk 26–30 那档设备只有这一条生效路径）；
            它同样是从这个 provider 的 meta-data 注册的，删 provider 等于删 profile；
          - androidx.emoji2.text.EmojiCompatInitializer、
            androidx.lifecycle.ProcessLifecycleInitializer：分别管 emoji 字体与
            进程级生命周期，都有别的东西在依赖，不在这张卡的账上。

          ⚠️ 摘掉 initializer 之后，BUAAApplication **必须**实现
          `androidx.work.Configuration.Provider`：work-runtime 2.9.1 的
          `WorkManagerImpl.getInstance(Context)` 在「未初始化 + Application 不是
          Configuration.Provider」时不自我初始化，而是直接抛
          IllegalStateException（反编译确认，message 里就写着 "You have explicitly
          disabled WorkManagerInitializer in your manifest"）。少了那一半改动，
          结果不是"晚点初始化"而是兜底任务静默消失。

          改动后应用内每一处 `WorkManager.getInstance` 都只在后台线程上被调到，
          逐条线程与进程入口见 docs/PERF-STARTUP-2026-09-19.md 的调用点线程表。
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                tools:node="remove" />
        </provider>

        <receiver
            android:name=".reminder.ReminderReceiver"
            android:exported="false" />

        <receiver
            android:name=".reminder.BootReceiver"
            android:exported="false">
            <!-- 只负责开机/升级重建。DATE_CHANGED / TIME_SET / TIMEZONE_CHANGED
                 由 WidgetRefreshReceiver 统一处理，避免同一事件被两个接收器各跑一遍 -->
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".reminder.TomorrowPreviewReceiver"
            android:exported="false" />

        <receiver
            android:name=".reminder.ClassProgressReceiver"
            android:exported="false" />

        <!-- 课程实况前台服务：specialUse FGS，用于澎湃实况窗/流体云样式的常驻进度通知 -->
        <service
            android:name=".reminder.CourseFluidService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="course_progress_fluid_cloud" />
        </service>

        <receiver
            android:name=".widget.WidgetRefreshReceiver"
            android:exported="false">
            <!-- 时间类变化（TIME_SET / TIMEZONE_CHANGED / DATE_CHANGED）的唯一入口，
                 BootReceiver 不再订阅，避免同一事件被两个接收器各跑一遍。
                 注意：系统改时间派发的是 android.intent.action.TIME_SET ——
                 代码里读的常量 Intent.ACTION_TIME_CHANGED 只是它的别名，
                 清单写成 "TIME_CHANGED" 会变成永不匹配的死过滤器 -->
            <intent-filter>
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.DATE_CHANGED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!--
            每个组件都额外声明 APPWIDGET_RESTORED：长按/拖动后宿主重新绑定视图时
            只会派发 manifest 里出现过的 action，而 ScheduleAppWidgetProvider 正是
            靠 onRestored 在这类重绑之后把外观设置重绘回来。
        -->
        <receiver
            android:name=".widget.TodayWidgetProvider"
            android:exported="true"
            android:label="@string/widget_today_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.appwidget.action.APPWIDGET_RESTORED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/today_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.TomorrowWidgetProvider"
            android:exported="true"
            android:label="@string/widget_tomorrow_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.appwidget.action.APPWIDGET_RESTORED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/tomorrow_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.WeekWidgetProvider"
            android:exported="true"
            android:label="@string/widget_week_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.appwidget.action.APPWIDGET_RESTORED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/week_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.WeekGridWidgetProvider"
            android:exported="true"
            android:label="@string/widget_week_grid_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.appwidget.action.APPWIDGET_RESTORED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/week_grid_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.NextClassWidgetProvider"
            android:exported="true"
            android:label="@string/widget_next_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.appwidget.action.APPWIDGET_RESTORED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/next_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.TwoDayWidgetProvider"
            android:exported="true"
            android:label="@string/widget_two_day_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.appwidget.action.APPWIDGET_RESTORED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/two_day_widget_info" />
        </receiver>
    </application>

</manifest>
